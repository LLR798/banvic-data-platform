extends: default

ignore: |
  .venv/
  ingestion/meltano/.meltano/
  transform/dbt/target/
  **/.terraform/

rules:
  document-start: disable
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
